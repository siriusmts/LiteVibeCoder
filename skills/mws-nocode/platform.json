  "contract": {
    "draft": "Supply a bot attributes object that validates against platform.json.",
    "graph": "Each scenario has a name, an event/init entry edge, nodes with unique ids and names, and nonempty blocks. Answer blocks have id, tags:null, type:answer, and value:text. Interactive menus use buttons [{title,target_node_id}] followed by wait_for_user; targets must refer to existing nodes.",
