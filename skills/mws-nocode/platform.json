  "response": {"dataKey": "data", "attributesKey": "attributes", "botIdFields": ["botId", "id"], "versionIdFields": ["id", "currentVersionId"], "scenariosField": "scenarios", "scenarioIdField": "id", "replyPath": ["data", "attributes", "payload", "items"]},
