    "enumFields": {"needPreprocess": ["disabled", "required", "optional"]},
    "scenariosField": "scenarios", "scenarioNameField": "name", "entryEdgesField": "entryEdges", "nodesField": "nodes", "nodeIdField": "id", "nodeNameField": "name", "blocksField": "blocks", "entryEvent": {"type": "event", "value": "init"}, "blockIdField": "id", "blockTypeField": "type", "answerType": "answer", "answerValueField": "value",
