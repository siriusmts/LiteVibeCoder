    "script": {"requiredPattern": "async\\s+def\\s+handler\\s*\\(context\\s*:\\s*Context\\)", "forbiddenPattern": "(?m)^\\s*(import|from)\\s+|\\b__import__\\s*\\(|\\bimportlib\\b", "forbiddenContextPatterns": ["\\bcontext\\.get\\s*\\(", "\\bcontext\\s*\\[", "\\bcontext\\.(?:session|system|temp|memory)\\.get\\s*\\(", "\\bcontext\\.(?:session|system|temp|memory)\\s*\\["], "networkAccess": false, "forbiddenNetworkPattern": "https?://"},
